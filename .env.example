# --- Configuração de ambiente (Sprint 4 — RAG) ---
# Copie este arquivo para `.env` e preencha com os valores reais.
# `.env` está no .gitignore e nunca deve ser versionado.

# Chave da API do Ollama (Ollama Cloud / endpoint autenticado).
# Em instalações locais via Ollama puro, normalmente fica vazia.
OLLAMA_API_KEY=

# Endpoint base do servidor Ollama.
# Local: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Nome do modelo de chat usado na chain RAG.
OLLAMA_MODEL=

# Modelo de embeddings (índice vetorial do ChromaDB).
OLLAMA_EMBEDDING_MODEL=

# --- Prompt do RAG (Sprint 4 — segunda iteração) ---

# Versão do system prompt usada pela chain RAG.
# Corresponde ao arquivo prompts/system_prompt_rag_v<VALOR>.txt.
# Sem esta variável, vale VERSAO_PROMPT_PADRAO em src/rag/prompt_rag.py.
# Aceita "3.1" ou "v3.1". Apontar para uma versão inexistente faz o
# pipeline levantar um erro que lista as versões disponíveis.
#
# É o que permite comparar iterações sem editar código:
#   PROMPT_RAG_VERSION=3.0 python evals/run_rag_eval.py --output evals/iteration_1.json
#   PROMPT_RAG_VERSION=3.1 python evals/run_rag_eval.py --output evals/iteration_2.json
PROMPT_RAG_VERSION=3.1